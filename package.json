{
  "name": "electronic-pet",
  "productName": "电子宠物",
  "version": "1.1.0",
  "description": "跨平台电子宠物：运行时 + hatch skill 皮肤模板，支持导入 Codex v2 皮肤包",
  "main": "src/main.js",
  "author": "guanyisheng",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "pack:mac": "electron-builder --mac dir",
    "pack:win": "electron-builder --win dir",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.electronic.pet",
    "productName": "电子宠物",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "dir"
      ],
      "icon": "assets/tray.png"
    },
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "assets/tray.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
