{
  "name": "electronic-pet",
  "productName": "电子宠物",
  "version": "1.0.0",
  "description": "macOS 电子宠物：透明置顶桌面宠物，播放 Codex v2 精灵图",
  "main": "src/main.js",
  "author": "guanyisheng",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac dir"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.electronic.pet",
    "productName": "电子宠物",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dir"
      ],
      "icon": "assets/tray.png"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
